# ==============================================================================
# Next.js Web Skeleton (Live Website) Standalone Environment Configuration
# ==============================================================================
# This configuration is strictly for the consumer live website frontend.
# It requires zero database access, zero database credentials, and zero CMS code.
# ==============================================================================

# Public Domain & Runtime Port
PORT=3000
SITE_DOMAIN=yourdomain.com

# Remote CMS Public API Connection
# Set to the public HTTPS domain where your Payload CMS is hosted (e.g. https://cms.yourdomain.com)
CMS_BASE_URL=https://cms.yourdomain.com
CMS_API_KEY=sk_replace_with_site_api_key
# Public custom domain in front of R2/S3 artifacts; no trailing slash.
CMS_ARTIFACT_BASE_URL=https://artifacts.example.com

# Inbound Revalidation Webhook Security
# Must match the REVALIDATION_SECRET and WEBHOOK_SECRET configured in Payload CMS.
# Webhooks sent from the CMS to /api/revalidate will be validated against this secret.
REVALIDATION_SECRET=replace_with_shared_revalidation_secret
WEBHOOK_SECRET=replace_with_shared_webhook_secret
REDIS_URL=redis://:replace_with_redis_password@redis:6379/0

# Next.js Draft Mode (For secure live side-by-side editorial preview)
DRAFT_MODE_SECRET=replace_with_shared_draft_mode_secret

# CDN / S3 / Cloudflare R2 Public Media Asset Domain
S3_PUBLIC_DOMAIN=https://media.yourdomain.com

# Cloudflare Zone Cache Purge (Optional, for production edge tier-1 invalidation)
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
